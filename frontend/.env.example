# Copy to .env and fill in. All frontend vars MUST be prefixed VITE_.

# Backend API base URL.
#  - Local dev (vite):   http://localhost:8000
#  - Same-origin / proxy: leave empty  ->  VITE_API_BASE_URL=
#  - AWS deployment:     paste the Terraform `api_base_url` output
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API key (optional — the app runs without it, minus the
# live map/ETA). See the main README for how to create and restrict a key.
VITE_GOOGLE_MAPS_API_KEY=
